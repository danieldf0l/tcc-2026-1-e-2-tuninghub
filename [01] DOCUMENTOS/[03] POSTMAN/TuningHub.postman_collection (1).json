{
  "info": {
    "name": "TuningHub API",
    "description": "Collection completa da API do TuningHub (TCC), organizada por módulo na mesma ordem em que foram revisados/testados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Usuário",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 200) {",
            "    pm.environment.set('token', pm.response.json().data.token);",
            "    console.log('Token de usuário salvo.');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"teste@tuninghub.com\",\n  \"senha\": \"Senha@123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login/usuario", "host": ["{{base_url}}"], "path": ["auth", "login", "usuario"] }
          }
        },
        {
          "name": "Login - Oficina",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 200) {",
            "    pm.environment.set('token', pm.response.json().data.token);",
            "    console.log('Token de oficina salvo.');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"oficina1@tuninghub.com\",\n  \"senha\": \"Senha@123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login/oficina", "host": ["{{base_url}}"], "path": ["auth", "login", "oficina"] }
          }
        },
        {
          "name": "Login - Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 200) {",
            "    pm.environment.set('token', pm.response.json().data.token);",
            "    console.log('Token de admin salvo.');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"master@tuninghub.com\",\n  \"senha\": \"SenhaForte@123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login/admin", "host": ["{{base_url}}"], "path": ["auth", "login", "admin"] }
          }
